# ── LiveKit connection ────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ── Next.js app (internal API) ────────────────────────────────────
APP_URL=http://localhost:3000
INTERNAL_BOT_SECRET=change-me-shared-secret

# ── LLM Provider: "groq" | "openai" | "ollama" ───────────────────
LLM_PROVIDER=groq

# ── Groq Provider (recommended default) ──────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Provider profile: "cloud" or "local" ─────────────────────────
PROFILE=cloud

# ── Cloud providers (used when PROFILE=cloud or LLM_PROVIDER=openai)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel           # any ElevenLabs voice id

# ── Local providers (used when PROFILE=local or LLM_PROVIDER=ollama)
# Install Ollama: https://ollama.com/download  (Windows exe)
# Pull model:    ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# faster-whisper model size: tiny | base | small | medium | large-v2
WHISPER_MODEL=base

# Piper voice (download from https://github.com/rhasspy/piper/releases)
PIPER_EXECUTABLE=piper
PIPER_VOICE_MODEL=en_US-lessac-medium.onnx

# ── Interview settings ────────────────────────────────────────────
INTERVIEW_DURATION_MIN=20           # total interview time limit
