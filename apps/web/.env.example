# Web app. Root .env is enough for local turbo; this file documents web-specific vars.

DATABASE_URL=postgresql://rehearse:rehearse@localhost:5432/rehearse
AUTH_SECRET=replace-with-32-plus-char-secret
AUTH_TRUST_HOST=true
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
INTERNAL_API_KEY=replace-with-shared-internal-key
AI_ENGINE_URL=http://localhost:4001
COMPILER_URL=http://localhost:4002

# Optional LLM keys (server-side only, never prefix with NEXT_PUBLIC_)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
